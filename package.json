{
  "name": "coach-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "components:dev": "vite --config tooling/components.vite.config.ts --host 127.0.0.1",
    "components:build": "vite build --config tooling/components.vite.config.ts",
    "components:preview": "vite preview --config tooling/components.vite.config.ts --host 127.0.0.1",
    "storybook": "storybook dev --config-dir tooling/storybook --port 6006 --no-open",
    "storybook:build": "storybook build --config-dir tooling/storybook --output-dir .artifacts/storybook --disable-telemetry",
    "test:components": "npm run components:build && playwright test --config tests/playwright.components.config.ts",
    "backend:start": "node tooling/supabase.mjs start -x realtime,storage-api,imgproxy,postgres-meta,studio,logflare,vector,supavisor",
    "backend:stop": "node tooling/supabase.mjs stop",
    "backend:status": "node tooling/supabase.mjs status",
    "backend:reset": "node tooling/supabase.mjs db reset --local",
    "backend:seed": "node tooling/seed-backend.mjs",
    "client:seed": "node tooling/seed-client.mjs",
    "backend:types": "node tooling/generate-db-types.mjs",
    "catalogue:import": "node tooling/import-exercises.mjs",
    "test:db": "node tooling/supabase.mjs test db",
    "test:backend": "node --test --test-concurrency=1 tests/backend/*.test.mjs",
    "check:backend": "npm run backend:reset && node tooling/supabase.mjs db lint --local --level error && npm run test:db && npm run test:backend && node tooling/generate-db-types.mjs --check",
    "dev": "vite --config tooling/vite.config.ts --host 127.0.0.1",
    "dev:client": "node tooling/client-local.mjs",
    "test:client": "node tooling/client-local.mjs test",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config tooling/vite.config.ts",
    "preview": "vite preview --config tooling/vite.config.ts --host 127.0.0.1",
    "test": "npm run test:browser:quick",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "test:browser:quick": "npm run test:browser -- --project=chromium",
    "test:ui": "npm run test:browser -- --ui --project=chromium",
    "test:headed": "npm run test:browser -- --headed --project=chromium",
    "test:report": "playwright show-report .artifacts/playwright-report",
    "check": "npm run typecheck && npm run build && playwright test --config tests/playwright.preview.config.ts"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.1",
    "supabase": "2.119.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
