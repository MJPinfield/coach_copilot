{
  "name": "coach-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:browser:quick",
    "test:browser": "playwright test",
    "test:browser:quick": "playwright test --project=chromium",
    "test:ui": "playwright test --ui --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:report": "playwright show-report",
    "check": "npm run typecheck && npm run build && playwright test --config=playwright.preview.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
